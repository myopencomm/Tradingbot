# ── AI Provider ──────────────────────────────────────────────────────────────
# Options: anthropic | openai | mistral | groq | gemini
# groq et gemini ont un tier GRATUIT
AI_PROVIDER=groq

# Remplissez UNIQUEMENT la clé du provider choisi
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Modèle IA (optionnel — laissez vide pour utiliser le modèle par défaut)
# anthropic  → claude-sonnet-4-6
# openai     → gpt-4o-mini
# mistral    → mistral-small-latest
# groq       → llama-3.3-70b-versatile  (tier gratuit)
AI_MODEL=

# ── Telegram ─────────────────────────────────────────────────────────────────
# Créez un bot via @BotFather sur Telegram
TELEGRAM_TOKEN=
# Votre Chat ID (envoyez /start à @userinfobot pour l'obtenir)
CHAT_ID=

# ── Règles de trading (optionnel — valeurs par défaut) ───────────────────────
DEFAULT_SL_PCT=10
DEFAULT_TP_PCT=15

# ── Stratégie momentum validée par la recherche (défauts recommandés) ────────
# Sélection : momentum 12 mois HORS dernier mois + cours > MM200, entrée sur
# repli sain (zone RSI) — jamais en surchauffe.
RSI_ENTRY_MIN=35          # borne basse de la zone d'entrée
RSI_ENTRY_MAX=65          # borne haute — au-delà on attend le repli
# Plancher de momentum 1 mois à l'entrée. Backtesté 2023→2026 : -5 est
# l'optimum (P&L et drawdown meilleurs qu'à -12, la règle d'origine) ; à 0 on
# n'achète que ce qui monte déjà et le résultat se DÉGRADE.
ENTRY_MIN_MOM_1M=-5
ENTRY_CRASH_MOM_1M=-12    # veto dur : un effondrement n'est jamais un repli

# ── Sortie sur stagnation — le capital doit tourner ──────────────────────────
# À J+STALE_DAYS_1 JOURS DE BOURSE, la position doit avoir parcouru
# STALE_PROGRESS_1 % du chemin PRU→TP. Sinon elle est vendue — mais JAMAIS à
# perte : la vente exige un cours au-dessus du PRU + frais de sortie.
# ⚠️ Backtesté : cette règle AMÉLIORE le taux de réussite et RÉDUIT le P&L
# (elle coupe les positions lentes qui finissaient par payer). Livrée au
# réglage le moins coûteux mesuré. STALE_EXIT=off pour la désactiver.
STALE_EXIT=on
STALE_DAYS_1=25
STALE_PROGRESS_1=33
STALE_DAYS_2=0            # second jalon, 0 = désactivé
STALE_PROGRESS_2=60
RSI_HARD_MAX=70           # veto dur à l'achat, indépendant de l'IA

# Stops adaptés à la volatilité du titre : distance SL ≈ ATR_SL_MULT × ATR14
ATR_SL_MULT=2.0
MIN_SL_PCT=3              # SL jamais plus serré (bruit)
MAX_SL_PCT=10             # SL jamais plus large (titre trop volatil → exclu)
MIN_RR=1.5                # TP ≥ 1.5× la distance du SL

# Veto « résultats imminents » : exclut à l'achat SEULEMENT si les prochains
# résultats tombent dans moins de N jours (un SL ne protège pas d'un gap de
# résultats). Au-delà : non bloquant (le momentum swing croise de toute façon
# des résultats). 6 = ~une semaine de bourse.
EARNINGS_VETO_DAYS=6

# Sizing par le risque : la perte au SL vaut ce % du budget autonome
RISK_PER_TRADE_PCT=1.0
MAX_POSITION_PCT=30       # coût max d'une position en % du budget autonome
VOL_SCALE_TRIGGER=1.5     # vol 20j > 1.5× vol 1 an → taille réduite de moitié
POSITION_BUDGET_PCT=50    # % du cash par position (suggestions /scan hors mode auto)
POSITION_BUDGET_MAX=1000  # plafond en € par position — sous 930€ le US se referme
# Balayage du reliquat : si le cash restant APRÈS l'achat tombe sous ce seuil, la
# position est agrandie pour l'absorber (ce fond ne pouvait financer aucun autre
# trade). PRIME sur MAX_POSITION_PCT → la perte au SL grandit dans la même
# proportion. 0 pour désactiver.
CASH_SWEEP_MIN_LEFTOVER=500

# Corrélation avec les positions déjà détenues (rendements quotidiens, 90j) :
# au-delà du seuil de veto, entrée bloquée (même pari qu'une position gérée
# par le bot) ; entre les deux seuils, risque réduit de moitié.
# Univers US decouvert automatiquement (liste officielle Nasdaq Trader).
# Seuil de liquidite applique au scan. 200 M$/j = ~550 valeurs solides ;
# 50 M$/j = ~1340 (plus de biotechs mid-cap) ; 0 = desactive, liste manuelle.
SCAN_US_MIN_DOLLAR_VOLUME=200000000

CORR_LOOKBACK_DAYS=90
CORR_DAMPEN_THRESHOLD=0.6
CORR_VETO_THRESHOLD=0.85

# Tolérance du trailing : BD arrondit au pas de cotation, donc un SL posé « au
# PRU » retombe quelques centimes dessous. En deçà de ce %, le SL est considéré
# comme déjà au breakeven (évite d'annuler/reposer la protection pour rien).
BREAKEVEN_TOLERANCE_PCT=0.3

# Trailing PALIER 1 (breakeven) : seuil de déclenchement du SL au PRU.
# Backtest 2023-2026 : +3% scratchait les futurs gagnants ; +6% = P&L ×9
AUTO_BREAKEVEN_PCT=6

# Trailing PALIER 2 (sécurisation du gain) : quand le cours a parcouru assez du
# chemin PRU→TP, le SL monte AU-DESSUS du PRU, à une fraction du gain acquis.
# La fraction grandit avec la progression : plus le TP est proche, plus on
# sécurise. Sans ce palier, une position à +9% d'un TP à +10% pouvait
# redescendre au PRU et sortir à zéro, tout le gain rendu.
TRAIL_LOCK_TRIGGER_PCT=60   # % du chemin PRU→TP avant de sécuriser
TRAIL_LOCK_MIN_RATIO=50     # % du gain verrouillé au déclenchement
TRAIL_LOCK_MAX_RATIO=80     # % du gain verrouillé au contact du TP
TRAIL_MIN_BUFFER_PCT=2      # marge mini sous le cours (ou 1×ATR si plus large)
# (seuils de déclenchement d'une remontée : voir la section dédiée en bas)

# Mode gain réduit (trades courts forcés quand rien ne passe) : OFF par défaut
# — schéma « overtrading » documenté, réactivez en connaissance de cause
SMALL_GAIN_MODE=off

# ─── Séance US (heure de Paris) ──────────────────────────────────────────────
# Wall Street est ouvert 15h30-22h00 Paris, bien après la clôture Euronext (17h30).
# Les 4 checks standards s'arrêtant à 17h, ON prolonge la surveillance et le scan
# sur la séance US. US_EXTENDED_HOURS=off pour l'ancien comportement (Europe seule).
US_EXTENDED_HOURS=on
US_CHECK_TIMES=18:00,20:00,21:40   # checks positions/ordres US uniquement (alertes SL/TP)
US_SCAN_TIME=16:00                 # scan d'opportunités US en début de séance (vide = off)

# IA de secours : providers essayés DANS L'ORDRE si le principal échoue
# (crédits épuisés, panne, rate limit). Chaque provider listé doit avoir sa
# clé (GEMINI_API_KEY, GROQ_API_KEY…). Configurable depuis Telegram :
# /fallback gemini CLE_API (teste la clé, l'écrit ici, supprime ton message).
# AI_FALLBACK_PROVIDERS=gemini,groq

# Dashboard (optionnel)
DASHBOARD_BIND=127.0.0.1   # 0.0.0.0 pour accès Tailscale/LAN (exige DASHBOARD_TOKEN)
DASHBOARD_TOKEN=          # jeton requis si exposition réseau — ex: openssl rand -hex 16

# ── Frais Bourse Direct ──────────────────────────────────────────────────────
# Le barème Euronext (0.99 / 1.90 / 2.90 / 3.80€ par tranche de montant) et les
# tarifs des places étrangères sont codés en dur dans config.py — ce sont les
# tarifs publics de BD, vérifiés au centime sur des ordres réels. Seuls les
# paramètres ci-dessous se règlent.
BROKERAGE_FEE_US=8.50         # par ordre US (NYSE/NASDAQ), jusqu'à 10 000€
TTF_RATE=0.004                # taxe sur les transactions financières française,
                              # à l'ACHAT, sociétés FR de plus de 1 Md€ (0.4% depuis 04/2025)
MIN_NET_GAIN_FEE_RATIO_US=5   # exigence de rentabilité côté étranger (voir README)
BROKERAGE_FEE=1.90            # override manuel du forfait Euronext (rarement utile)
MIN_NET_GAIN_FEE_RATIO=5      # idem côté Euronext : gain brut au TP ≥ 5× les frais A/R

# ── Sync Gmail (optionnel) ───────────────────────────────────────────────────
# Détecte les emails BD « Finalisation de votre stratégie » pour clôturer les
# positions automatiquement. Mot de passe d'application, PAS le mot de passe
# du compte : https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ── Alertes et seuils divers ─────────────────────────────────────────────────
BREAKEVEN_THRESHOLD=5   # gain % à partir duquel le SL manuel remonte au PRU
                        # (le mode autonome utilise AUTO_BREAKEVEN_PCT, plus haut)
TP_ALERTS=on            # off = plus d'alerte « TP approché » dans les checks
FALLBACK_TP_MIN_PCT=3   # bornes du TP calculé par défaut quand l'IA n'en fournit
FALLBACK_TP_MAX_PCT=8   # pas un exploitable

# ── Trailing : quand une remontée du SL vaut-elle son risque ? ───────────────
# Chaque remontée annule les DEUX ordres BD (SL et TP — BD ne sait pas modifier
# un Expert) et en repose un. Entre les deux, la position n'a AUCUNE protection.
# Une remontée doit franchir LES DEUX seuils :
#   · en euros — le coût FIXE (risque qu'une annulation/repose tourne mal) ;
#     commande les petites lignes, où 1 % du PRU ne fait que quelques euros
#   · en % du PRU — le coût PROPORTIONNEL (ce qui est exposé pendant la
#     fenêtre) ; commande les grosses lignes, pour éviter de ratcheter à
#     chaque frémissement du cours
TRAIL_MIN_STEP_EUR=5      # gain verrouillé minimum pour justifier une remontée
TRAIL_MIN_STEP_PCT=0.2    # ...et jamais plus fin que ça, quelle que soit la taille
